rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Users can only upload and read wallpapers in their own directory
    match /users/{userId}/wallpapers/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
